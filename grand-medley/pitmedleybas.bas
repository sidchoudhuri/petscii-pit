70 FOR R=O TO 20:POKE K3,SH:POKE K0,DL:POKE K1,DH:POKE K4,O:POKE K5,Z:SYS Y:SH=SH+O:DL=DL+Z:IF DL>U THEN DL=DL-V:DH=DH+O
