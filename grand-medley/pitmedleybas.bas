30 REM COPY N BYTES FROM S TO D WITH THE BASIC ROM BLOCK MOVE (EYVIND EBSEN)
40 SH=INT(S*Q8):POKE K2,S-V*SH:POKE K3,SH:DH=INT(D*Q8):POKE K0,D-V*DH:POKE K1,DH:POKE K4,O:POKE K5,N:SYS Y:RETURN
