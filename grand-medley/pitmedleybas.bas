120 T=0
130 BF=1-BF:DB=49152+1024*BF:GOSUB 350:T=T+2:LM=40-T:GOSUB 420
140 POKE 53272,2+16*BF:IF LM>0 THEN S=CS+P-1:D=56136:N=LM:GOSUB 30
150 S=52480:D=56136+LM:N=T:GOSUB 30:P=P+2:IF P>192 THEN P=P-192
160 F=1-F:IF T<40 THEN 130
170 DB=49152+1024*(1-BF):GOSUB 420
