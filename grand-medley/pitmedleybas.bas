510 IF DS=6 THEN DS=7:MI=1:FR=0:BM=0:PR=ASC(RB$(L))-47:PC=ASC(MID$(RB$(L),2,1))-47:GOSUB 620:R=PR:C=PC:G=6:GOTO 740
520 IF MI>LEN(MV$(L)) THEN MI=MI+1:IF MI>LEN(MV$(L))+6 THEN L=(L+1) AND 3:DS=0
530 IF MI>LEN(MV$(L)) THEN RETURN
540 M$=MID$(MV$(L),MI,1):MI=MI+1:FR=1-FR:IF BM THEN BM=0:R=PR:C=PC:G=6:GOSUB 740
550 FOR I=1 TO MN:R=MR%(I):C=MC%(I):IF T%(R,C)>=8 AND V%(R,C) THEN G=T%(R,C)+FR:GOSUB 740
560 NEXT I:IF M$="S" THEN RETURN
570 X=ASC(M$):TR=PR+DR%(X):TC=PC+DC%(X):IF MT%(X)=0 THEN 600
580 R=PR:C=PC:G=7:GOSUB 740:BM=1:IF MT%(X)=2 THEN T%(TR,TC)=2:R=TR:C=TC:G=2:GOSUB 740
590 RETURN
600 IF T%(TR,TC)=4 OR T%(TR,TC)=5 THEN T%(TR,TC)=2
610 R=PR:C=PC:PR=TR:PC=TC:G=T%(R,C):GOSUB 740:R=PR:C=PC:G=6:GOSUB 740
620 REM REVEAL THE ROOM ON ENTRY AND THE CORRIDOR NEXT TO THE THIEF
630 K$=MID$(Z$(L,PR),PC+1,1):IF K$>="0" AND K$<="9" THEN K=VAL(K$):IF RS%(K)=0 THEN GOSUB 680
640 FOR Q=0 TO 4:R=PR+QR%(Q):C=PC+QC%(Q):IF R>=0 AND R<=5 AND C>=0 AND C<=37 THEN IF V%(R,C)=0 THEN GOSUB 660
650 NEXT Q:RETURN
660 IF MID$(Z$(L,R),C+1,1)="-" THEN V%(R,C)=1:GOTO 720
670 RETURN
680 RS%(K)=1:R0=ASC(MID$(RB$(L),4*K+1,1))-48:C0=ASC(MID$(RB$(L),4*K+2,1))-48
690 R1=ASC(MID$(RB$(L),4*K+3,1))-48:C1=ASC(MID$(RB$(L),4*K+4,1))-48
