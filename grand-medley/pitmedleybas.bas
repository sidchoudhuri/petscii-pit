190 FOR W=1 TO 22:BF=1-BF:DB=49152+1024*BF:GOSUB 350:POKE 53272,2+16*BF:S=52600:D=55296+40*W:N=40:GOSUB 30:NEXT W
200 REM SHRINK TO 8X8
210 FOR W=1 TO 14:GOSUB 400:GOSUB 450:NEXT W:FOR W=1 TO 10:GOSUB 400:NEXT W
220 REM TWO DANCER BANDS, THE PORTRAIT SHRINKS AWAY, THEN THE DUNGEON
230 FOR W=0 TO 7:C=SC(W):S=CB(C):D=55336+40*W:N=40:GOSUB 30:D=55896+40*W:GOSUB 30:NEXT W
240 PA=1:PB=121:N2=7:DG=0:B2=1
250 BF=1-BF:DB=49152+1024*BF:GOSUB 350:POKE K2,PA-O:SH=SM(F):D=DB+40:GOSUB 410
260 FOR R=O TO 8:POKE K3,SH:POKE K0,DL:POKE K1,DH:POKE K4,O:POKE K5,Z:SYS Y:SH=SH+O:DL=DL+Z:IF DL>U THEN DL=DL-V:DH=DH+O
270 NEXT R:POKE K2,39+PB:SH=SM(F):D=DB+600:GOSUB 410
280 FOR R=O TO 8:POKE K3,SH:POKE K0,DL:POKE K1,DH:POKE K4,O:POKE K5,Z:SYS Y:SH=SH+O:DL=DL+Z:IF DL>U THEN DL=DL-V:DH=DH+O
