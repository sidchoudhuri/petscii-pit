300 PA=PA+2:IF PA>120 THEN PA=PA-80
310 PB=PB-2:IF PB<1 THEN PB=PB+80
320 F=1-F:IF N2>0 THEN N2=N2-1:GOSUB 450:IF N2=0 THEN DG=1:L=0:DS=0
330 IF DG THEN GOSUB 490
340 GOTO 250
350 REM TOP ROW LEFT TO RIGHT, BOTTOM ROW RIGHT TO LEFT
360 S=TP+TA-1:D=DB:N=40:GOSUB 30:TA=TA-1:IF TA<1 THEN TA=56
370 S=BA+TB-1:IF TB>160 THEN S=BB+TB-161
380 D=DB+960:N=40:GOSUB 30:TB=TB+1:IF TB>275 THEN TB=1
390 RETURN
400 BF=1-BF:DB=49152+1024*BF:GOSUB 350:POKE 53272,2+16*BF:RETURN
