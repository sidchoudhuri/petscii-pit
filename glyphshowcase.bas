10 REM PETSCII PIT - CUSTOM GLYPH SHOWCASE
20 IF PEEK(38654)<>80 OR PEEK(38655)<>80 THEN PRINT "PLEASE LOAD PETSCII PIT FIRST":END
30 POKE 45,PEEK(174):POKE 46,PEEK(175):CLR
40 DV=PEEK(186):IF DV<8 THEN DV=8
50 POKE 53280,0:POKE 53281,0:PRINT CHR$(147)
60 SB=49152:CB=55296:DIM GC%(11),RW%(11),CO%(11)
70 PRINT CHR$(147)
80 POKE 211,4:POKE 214,0:SYS 58732:POKE 646,1:PRINT "{WHT}PETSCII PIT V18 - CUSTOM GLYPHS"
90 FOR N=1 TO 11
100 READ GC,CL,RW,CO,LB$:GC%(N)=GC:RW%(N)=RW:CO%(N)=CO
110 IX=RW*40+CO:POKE SB+IX,GC:POKE CB+IX,CL
120 IX=RW*40+CO+1:POKE SB+IX,GC:POKE CB+IX,CL
130 IX=(RW+1)*40+CO:POKE SB+IX,GC:POKE CB+IX,CL
140 IX=(RW+1)*40+CO+1:POKE SB+IX,GC:POKE CB+IX,CL
150 POKE 211,CO:POKE 214,RW+2:SYS 58732:POKE 646,15:PRINT LB$
160 NEXT N
170 DATA 0,3,2,2,"PLAYER"
180 DATA 31,11,2,12,"FLOOR"
190 DATA 30,5,2,22,"POTION"
200 DATA 36,8,2,32,"TREASURE"
210 DATA 83,5,9,2,"LEECH"
220 DATA 88,7,9,12,"GOBLIN"
230 DATA 90,8,9,22,"IMP"
240 DATA 86,10,9,32,"GUARD"
250 DATA 91,2,16,2,"CULTIST"
260 DATA 65,4,16,12,"GOLEM"
270 DATA 62,7,16,22,"STAIRS"
280 POKE 211,1:POKE 214,22:SYS 58732:POKE 646,15:PRINT "{GRY1}SPACE - NEXT TRACK V - VOLUME  Q - QUIT";
290 SYS 38662:TR=0:VL=15:GOSUB 360
300 GET A$:IF A$="" THEN GOSUB 430:GOTO 300
310 IF A$=" " AND TR=0 THEN TR=1:SYS 38678:GOSUB 360:GOTO 300
320 IF A$=" " AND TR=1 THEN TR=2:POKE 780,1:SYS 38690:SYS 38681:GOSUB 360:GOTO 300
330 IF A$=" " AND TR=2 THEN TR=0:POKE 780,0:SYS 38690:GOSUB 360:GOTO 300
340 IF A$<>"Q" THEN ON -(A$="V") GOSUB 410:GOTO 300
350 SYS 38665:PRINT CHR$(147):LOAD"PETSCII PIT",DV
360 POKE 211,7:POKE 214,20:SYS 58732
370 IF TR=0 THEN PRINT "{GRY2}NOW PLAYING: {WHT}DUNGEONEERING";
380 IF TR=1 THEN PRINT "{GRY2}NOW PLAYING: {WHT}ASSAILING    ";
390 IF TR=2 THEN PRINT "{GRY2}NOW PLAYING: {WHT}LAMENTING    ";
400 RETURN
410 VL=(VL+3)*-(VL<15):NB=INT(VL/3+.5):POKE 54296,VL:POKE 54328,VL
420 POKE 211,14:POKE 214,24:SYS 58732:PRINT "{WHT}VOLUME {RVON}"LEFT$("     ",NB)"{RVOF}"LEFT$("{CBM-+}{CBM-+}{CBM-+}{CBM-+}{CBM-+}",5-NB);:RETURN
430 IF TI<T4 THEN RETURN
440 T4=TI+25:AF=1-AF:PF=(PF+1)AND 3:FOR N=1 TO 10:IF N=1 OR N>4 THEN GOSUB 460
450 NEXT N:RETURN
460 G=GC%(N)+128*AF:IF N=1 THEN G=VAL(MID$("000129130128",PF*3+1,3))
470 IX=RW%(N)*40+CO%(N):POKE SB+IX,G:POKE SB+IX+1,G:POKE SB+IX+40,G:POKE SB+IX+41,G:RETURN
