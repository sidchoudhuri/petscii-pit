10 REM PETSCII PIT - HTTPS://M0NDE.ITCH.IO
20 SB=1024:CB=55296:SI=54272:PRINT CHR$(147)
30 POKE 53280,0:POKE 53281,0
40 DIM MA(999),RM(999),FG(999)
50 DIM RX(7),RY(7),RW(7),RH(7),RV(7)
60 DIM MX(9),MY(9),MH(9),MP(9),ML(9)
70 WC=35:FC=46:XC=62:BL=32:PC=0:MC=13
80 K1=11:K2=15:K3=1:K4=2:K5=7:K6=0
90 POKE 646,1:GOSUB 1540
100 GOSUB 1520
110 X=RND(-(TI*(PEEK(53266)+TI))):PH=20:PM=20:PA=4:LV=1:GS=0:MU=0
120 POKE SI+24,15:POKE SI+5,9:POKE SI+6,0
130 GOSUB 150
140 GOTO 660
150 POKE 646,1:PRINT CHR$(147);"{GRY2}BUILDING DUNGEON, PLEASE WAIT..."
160 FOR IX=0 TO 999:MA(IX)=0:RM(IX)=0:FG(IX)=0:NEXT IX
170 NR=5+INT(RND(1)*3)
180 FOR I=1 TO NR
190 TR=0
200 W1=4+INT(RND(1)*4):H1=3+INT(RND(1)*3)
210 X1=2+INT(RND(1)*(35-W1)):Y1=2+INT(RND(1)*(19-H1))
220 OK=1
230 FOR J=1 TO I-1
240 IF X1+W1+1<RX(J) OR RX(J)+RW(J)+1<X1 OR Y1+H1+1<RY(J) OR RY(J)+RH(J)+1<Y1 THEN 260
250 OK=0
260 NEXT J
270 TR=TR+1
280 IF OK=0 AND TR<2000 THEN 200
290 RX(I)=X1:RY(I)=Y1:RW(I)=W1:RH(I)=H1:RV(I)=0
300 NEXT I
310 FOR I=1 TO NR
320 FOR Y=RY(I) TO RY(I)+RH(I)-1
330 FOR X=RX(I) TO RX(I)+RW(I)-1
340 IX=Y*40+X
350 IF X=RX(I) OR X=RX(I)+RW(I)-1 OR Y=RY(I) OR Y=RY(I)+RH(I)-1 THEN MA(IX)=2:GOTO 370
360 MA(IX)=1:RM(IX)=I
370 NEXT X
380 NEXT Y
390 NEXT I
400 FOR I=1 TO NR-1
410 CX=RX(I)+INT(RW(I)/2):CY=RY(I)+INT(RH(I)/2)
420 EX=RX(I+1)+INT(RW(I+1)/2):EY=RY(I+1)+INT(RH(I+1)/2)
430 X=CX
440 IF X=EX THEN 480
450 IX=CY*40+X:MA(IX)=1
460 X=X+SGN(EX-CX)
470 GOTO 440
480 Y=CY
490 IF Y=EY THEN 530
500 IX=Y*40+EX:MA(IX)=1
510 Y=Y+SGN(EY-CY)
520 GOTO 490
530 NEXT I
540 IX=(RY(NR)+INT(RH(NR)/2))*40+(RX(NR)+INT(RW(NR)/2)):MA(IX)=9
550 MN=NR-2:IF MN<1 THEN MN=0
560 FOR I=1 TO MN
570 J=I+1
580 MX(I)=RX(J)+INT(RW(J)/2):MY(I)=RY(J)+INT(RH(J)/2)
590 MH(I)=6:MP(I)=2:ML(I)=1
600 NEXT I
610 FOR IX=0 TO 999:POKE SB+IX,BL:POKE CB+IX,K6:NEXT IX
620 PX=RX(1)+INT(RW(1)/2):PY=RY(1)+INT(RH(1)/2)
630 RQ=1:GOSUB 1230
640 IX=PY*40+PX:POKE SB+IX,PC:POKE CB+IX,K3
650 RETURN
660 GET A$:IF A$="" THEN 660
670 IF A$="M" THEN MU=1-MU:GOTO 660
680 IF A$="I" THEN GOSUB 1540:GOSUB 1520:GOSUB 1640:GOTO 660
690 DX=0:DY=0
700 IF A$="W" OR ASC(A$)=145 THEN DY=-1
710 IF A$="S" OR ASC(A$)=17 THEN DY=1
720 IF A$="A" OR ASC(A$)=157 THEN DX=-1
730 IF A$="D" OR ASC(A$)=29 THEN DX=1
740 IF DX=0 AND DY=0 AND A$<>" " THEN 660
750 IF DX=0 AND DY=0 THEN 980
760 NX=PX+DX:NY=PY+DY
770 IF NX<0 OR NX>39 OR NY<0 OR NY>24 THEN GOSUB 1370:GOTO 660
780 IX=NY*40+NX
790 IF MA(IX)=2 OR MA(IX)=0 THEN GOSUB 1370:GOTO 660
800 TG=0
810 FOR I=1 TO MN
820 IF ML(I)=1 AND MX(I)=NX AND MY(I)=NY THEN TG=I
830 NEXT I
840 IF TG=0 THEN 890
850 MH(TG)=MH(TG)-PA:GOSUB 1400
860 IF MH(TG)>0 THEN 980
870 ML(TG)=0:IX=MY(TG)*40+MX(TG):GOSUB 1330:GOSUB 1460
880 GOTO 980
890 IX=PY*40+PX:GOSUB 1330
900 PX=NX:PY=NY:IX=PY*40+PX
910 IF MA(IX)=9 THEN GOSUB 1490:LV=LV+1:GOSUB 150:GOTO 660
920 RQ=RM(IX)
930 IF RQ>0 AND RV(RQ)=0 THEN GOSUB 1230
940 IF RQ=0 AND FG(IX)=0 THEN FG(IX)=1:GOSUB 1330
950 IX=PY*40+PX
960 POKE SB+IX,PC:POKE CB+IX,K3
970 GOSUB 1430
980 FOR I=1 TO MN
990 IF ML(I)=0 THEN 1140
1000 IF RM(MY(I)*40+MX(I))=0 THEN 1140
1010 IF RV(RM(MY(I)*40+MX(I)))=0 THEN 1140
1020 EX=0:EY=0
1030 IF PX<MX(I) THEN EX=-1
1040 IF PX>MX(I) THEN EX=1
1050 IF PY<MY(I) THEN EY=-1
1060 IF PY>MY(I) THEN EY=1
1070 IF ABS(PX-MX(I))>=ABS(PY-MY(I)) THEN EY=0
1080 IF ABS(PX-MX(I))<ABS(PY-MY(I)) THEN EX=0
1090 IF EX=0 AND EY=0 THEN 1140
1100 NX=MX(I)+EX:NY=MY(I)+EY
1110 IF NX=PX AND NY=PY THEN PH=PH-MP(I):GOSUB 1400:GOTO 1140
1120 IX=NY*40+NX:IF MA(IX)=2 OR MA(IX)=0 THEN 1140
1130 IX=MY(I)*40+MX(I):GOSUB 1330:MX(I)=NX:MY(I)=NY:IX=MY(I)*40+MX(I):POKE SB+IX,MC:POKE CB+IX,K4
1140 NEXT I
1150 IF PH<=0 THEN GOTO 1170
1160 GOTO 660
1170 FOR IX=0 TO 999:POKE SB+IX,BL:POKE CB+IX,K6:NEXT IX
1180 POKE 646,1:PRINT CHR$(19);"GAME OVER - REACHED LEVEL ";LV
1190 PRINT "PRESS ANY KEY TO RESTART"
1200 GET A$:IF A$="" THEN 1200
1210 PH=PM:LV=1:GOSUB 150
1220 GOTO 660
1230 FOR Y=RY(RQ) TO RY(RQ)+RH(RQ)-1
1240 FOR X=RX(RQ) TO RX(RQ)+RW(RQ)-1
1250 IX=Y*40+X:FG(IX)=1:GOSUB 1330
1260 NEXT X
1270 NEXT Y
1280 RV(RQ)=1
1290 FOR I=1 TO MN
1300 IF ML(I)=1 AND RM(MY(I)*40+MX(I))=RQ THEN IX=MY(I)*40+MX(I):POKE SB+IX,MC:POKE CB+IX,K4
1310 NEXT I
1320 RETURN
1330 IF MA(IX)=2 THEN POKE SB+IX,WC:POKE CB+IX,K1:RETURN
1340 IF MA(IX)=1 THEN POKE SB+IX,FC:POKE CB+IX,K2:RETURN
1350 IF MA(IX)=9 THEN POKE SB+IX,XC:POKE CB+IX,K5:RETURN
1360 POKE SB+IX,BL:POKE CB+IX,K6:RETURN
1370 IF MU=1 THEN RETURN
1380 POKE SI+1,20:POKE SI+0,0:POKE SI+4,129:FOR DL=1 TO 20:NEXT DL:POKE SI+4,128
1390 RETURN
1400 IF MU=1 THEN RETURN
1410 POKE SI+1,60:POKE SI+0,0:POKE SI+4,33:FOR DL=1 TO 40:NEXT DL:POKE SI+4,32
1420 RETURN
1430 IF MU=1 THEN RETURN
1440 POKE SI+1,10:POKE SI+0,0:POKE SI+4,17:FOR DL=1 TO 10:NEXT DL:POKE SI+4,16
1450 RETURN
1460 IF MU=1 THEN RETURN
1470 POKE SI+1,80:POKE SI+0,0:POKE SI+4,129:FOR DL=1 TO 60:NEXT DL:POKE SI+1,40:FOR DL=1 TO 60:NEXT DL:POKE SI+4,128
1480 RETURN
1490 IF MU=1 THEN RETURN
1500 POKE SI+1,100:POKE SI+0,0:POKE SI+4,17:FOR DL=1 TO 50:NEXT DL:POKE SI+1,150:FOR DL=1 TO 50:NEXT DL:POKE SI+4,16
1510 RETURN
1520 GET A$:IF A$="" THEN 1520
1530 RETURN
1540 POKE 646,1:PRINT CHR$(147);"PETSCII PIT"
1550 PRINT:PRINT "{GRY2}WASD OR CURSOR KEYS{WHT} - MOVE"
1560 PRINT "{GRY2}WALK INTO A MONSTER - {WHT}ATTACK"
1570 PRINT "{GRY2}SPACE {WHT}- WAIT ONE TURN"
1580 PRINT "{GRY2}M {WHT}- TOGGLE SOUND"
1590 PRINT "{GRY2}I {WHT}- SHOW THIS SCREEN ANYTIME"
1600 PRINT:PRINT "{WHT}FIND THE STAIRS EACH LEVEL"
1610 PRINT "{WHT}AVOID OR FIGHT THE MONSTERS"
1620 PRINT:PRINT "{GRY2}PRESS ANY KEY TO CONTINUE"
1630 PRINT "{WHT}HTTPS://M0NDE.ITCH.IO/PETSCII-PIT":RETURN
1640 FOR IX=0 TO 999:POKE SB+IX,BL:POKE CB+IX,K6:NEXT IX
1650 FOR IX=0 TO 999:IF FG(IX)=1 THEN GOSUB 1330
1660 NEXT IX
1670 FOR I=1 TO MN
1680 IF ML(I)=1 THEN IX=MY(I)*40+MX(I):IF FG(IX)=1 THEN POKE SB+IX,MC:POKE CB+IX,K4
1690 NEXT I
1700 IX=PY*40+PX:POKE SB+IX,PC:POKE CB+IX,K3
