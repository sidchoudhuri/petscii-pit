10 REM PETSCII PIT - HTTPS://M0NDE.ITCH.IO
20 SB=1024:CB=55296:SI=54272:PRINT CHR$(147)
30 POKE 53280,0:POKE 53281,0
40 DIM MA(999),RM(999),FG(999)
50 DIM RX(7),RY(7),RW(7),RH(7),RV(7)
60 DIM MX(9),MY(9),MH(9),MP(9),ML(9)
70 WC=35:FC=46:XC=62:BL=32:PC=0:MC=13
80 K1=11:K2=15:K3=1:K4=2:K5=7:K6=0
90 POKE 646,1:PRINT "PETSCII PIT - HTTPS://M0NDE.ITCH.IO":PRINT:PRINT "PRESS ANY KEY TO BEGIN"
100 GET A$:IF A$="" THEN 100
110 X=RND(-(TI*(PEEK(53266)+TI))):PH=20:PM=20:PA=4:LV=1:GS=0:MU=0
120 POKE SI+24,15:POKE SI+5,9:POKE SI+6,0
130 GOSUB 150
140 GOTO 660
150 POKE 646,1:PRINT CHR$(147);"BUILDING DUNGEON, PLEASE WAIT..."
160 FOR IX=0 TO 999:MA(IX)=0:RM(IX)=0:FG(IX)=0:NEXT IX
170 NR=5+INT(RND(1)*3)
180 FOR I=1 TO NR
190 TR=0
200 W1=4+INT(RND(1)*4):H1=3+INT(RND(1)*3)
210 X1=2+INT(RND(1)*(35-W1)):Y1=2+INT(RND(1)*(19-H1))
220 OK=1
230 FOR J=1 TO I-1
240 IF X1+W1+1<RX(J) OR RX(J)+RW(J)+1<X1 OR Y1+H1+1<RY(J) OR RY(J)+RH(J)+1<Y1 THEN 260
250 OK=0
260 NEXT J
270 TR=TR+1
280 IF OK=0 AND TR<2000 THEN 200
290 RX(I)=X1:RY(I)=Y1:RW(I)=W1:RH(I)=H1:RV(I)=0
300 NEXT I
310 FOR I=1 TO NR
320 FOR Y=RY(I) TO RY(I)+RH(I)-1
330 FOR X=RX(I) TO RX(I)+RW(I)-1
340 IX=Y*40+X
350 IF X=RX(I) OR X=RX(I)+RW(I)-1 OR Y=RY(I) OR Y=RY(I)+RH(I)-1 THEN MA(IX)=2:GOTO 370
360 MA(IX)=1:RM(IX)=I
370 NEXT X
380 NEXT Y
390 NEXT I
400 FOR I=1 TO NR-1
410 CX=RX(I)+INT(RW(I)/2):CY=RY(I)+INT(RH(I)/2)
420 EX=RX(I+1)+INT(RW(I+1)/2):EY=RY(I+1)+INT(RH(I+1)/2)
430 X=CX
440 IF X=EX THEN 480
450 IX=CY*40+X:MA(IX)=1
460 X=X+SGN(EX-CX)
470 GOTO 440
480 Y=CY
490 IF Y=EY THEN 530
500 IX=Y*40+EX:MA(IX)=1
510 Y=Y+SGN(EY-CY)
520 GOTO 490
530 NEXT I
540 IX=(RY(NR)+INT(RH(NR)/2))*40+(RX(NR)+INT(RW(NR)/2)):MA(IX)=9
550 MN=NR-2:IF MN<1 THEN MN=0
560 FOR I=1 TO MN
570 J=I+1
580 MX(I)=RX(J)+INT(RW(J)/2):MY(I)=RY(J)+INT(RH(J)/2)
590 MH(I)=6:MP(I)=2:ML(I)=1
600 NEXT I
610 FOR IX=0 TO 999:POKE SB+IX,BL:POKE CB+IX,K6:NEXT IX
620 PX=RX(1)+INT(RW(1)/2):PY=RY(1)+INT(RH(1)/2)
630 RQ=1:GOSUB 1220
640 IX=PY*40+PX:POKE SB+IX,PC:POKE CB+IX,K3
650 RETURN
660 GET A$:IF A$="" THEN 660
670 IF A$="M" THEN MU=1-MU:GOTO 660
680 DX=0:DY=0
690 IF A$="W" OR ASC(A$)=145 THEN DY=-1
700 IF A$="S" OR ASC(A$)=17 THEN DY=1
710 IF A$="A" OR ASC(A$)=157 THEN DX=-1
720 IF A$="D" OR ASC(A$)=29 THEN DX=1
730 IF DX=0 AND DY=0 AND A$<>" " THEN 660
740 IF DX=0 AND DY=0 THEN 970
750 NX=PX+DX:NY=PY+DY
760 IF NX<0 OR NX>39 OR NY<0 OR NY>24 THEN GOSUB 1360:GOTO 660
770 IX=NY*40+NX
780 IF MA(IX)=2 OR MA(IX)=0 THEN GOSUB 1360:GOTO 660
790 TG=0
800 FOR I=1 TO MN
810 IF ML(I)=1 AND MX(I)=NX AND MY(I)=NY THEN TG=I
820 NEXT I
830 IF TG=0 THEN 880
840 MH(TG)=MH(TG)-PA:GOSUB 1390
850 IF MH(TG)>0 THEN 970
860 ML(TG)=0:IX=MY(TG)*40+MX(TG):GOSUB 1320:GOSUB 1450
870 GOTO 970
880 IX=PY*40+PX:GOSUB 1320
890 PX=NX:PY=NY:IX=PY*40+PX
900 IF MA(IX)=9 THEN GOSUB 1480:LV=LV+1:GOSUB 150:GOTO 660
910 RQ=RM(IX)
920 IF RQ>0 AND RV(RQ)=0 THEN GOSUB 1220
930 IF RQ=0 AND FG(IX)=0 THEN FG(IX)=1:GOSUB 1320
940 IX=PY*40+PX
950 POKE SB+IX,PC:POKE CB+IX,K3
960 GOSUB 1420
970 FOR I=1 TO MN
980 IF ML(I)=0 THEN 1130
990 IF RM(MY(I)*40+MX(I))=0 THEN 1130
1000 IF RV(RM(MY(I)*40+MX(I)))=0 THEN 1130
1010 EX=0:EY=0
1020 IF PX<MX(I) THEN EX=-1
1030 IF PX>MX(I) THEN EX=1
1040 IF PY<MY(I) THEN EY=-1
1050 IF PY>MY(I) THEN EY=1
1060 IF ABS(PX-MX(I))>=ABS(PY-MY(I)) THEN EY=0
1070 IF ABS(PX-MX(I))<ABS(PY-MY(I)) THEN EX=0
1080 IF EX=0 AND EY=0 THEN 1130
1090 NX=MX(I)+EX:NY=MY(I)+EY
1100 IF NX=PX AND NY=PY THEN PH=PH-MP(I):GOSUB 1390:GOTO 1130
1110 IX=NY*40+NX:IF MA(IX)=2 OR MA(IX)=0 THEN 1130
1120 IX=MY(I)*40+MX(I):GOSUB 1320:MX(I)=NX:MY(I)=NY:IX=MY(I)*40+MX(I):POKE SB+IX,MC:POKE CB+IX,K4
1130 NEXT I
1140 IF PH<=0 THEN GOTO 1160
1150 GOTO 660
1160 FOR IX=0 TO 999:POKE SB+IX,BL:POKE CB+IX,K6:NEXT IX
1170 POKE 646,1:PRINT CHR$(19);"GAME OVER - REACHED LEVEL ";LV
1180 PRINT "PRESS ANY KEY TO RESTART"
1190 GET A$:IF A$="" THEN 1190
1200 PH=PM:LV=1:GOSUB 150
1210 GOTO 660
1220 FOR Y=RY(RQ) TO RY(RQ)+RH(RQ)-1
1230 FOR X=RX(RQ) TO RX(RQ)+RW(RQ)-1
1240 IX=Y*40+X:FG(IX)=1:GOSUB 1320
1250 NEXT X
1260 NEXT Y
1270 RV(RQ)=1
1280 FOR I=1 TO MN
1290 IF ML(I)=1 AND RM(MY(I)*40+MX(I))=RQ THEN IX=MY(I)*40+MX(I):POKE SB+IX,MC:POKE CB+IX,K4
1300 NEXT I
1310 RETURN
1320 IF MA(IX)=2 THEN POKE SB+IX,WC:POKE CB+IX,K1:RETURN
1330 IF MA(IX)=1 THEN POKE SB+IX,FC:POKE CB+IX,K2:RETURN
1340 IF MA(IX)=9 THEN POKE SB+IX,XC:POKE CB+IX,K5:RETURN
1350 POKE SB+IX,BL:POKE CB+IX,K6:RETURN
1360 IF MU=1 THEN RETURN
1370 POKE SI+1,20:POKE SI+0,0:POKE SI+4,129:FOR DL=1 TO 20:NEXT DL:POKE SI+4,128
1380 RETURN
1390 IF MU=1 THEN RETURN
1400 POKE SI+1,60:POKE SI+0,0:POKE SI+4,33:FOR DL=1 TO 40:NEXT DL:POKE SI+4,32
1410 RETURN
1420 IF MU=1 THEN RETURN
1430 POKE SI+1,10:POKE SI+0,0:POKE SI+4,17:FOR DL=1 TO 10:NEXT DL:POKE SI+4,16
1440 RETURN
1450 IF MU=1 THEN RETURN
1460 POKE SI+1,80:POKE SI+0,0:POKE SI+4,129:FOR DL=1 TO 60:NEXT DL:POKE SI+1,40:FOR DL=1 TO 60:NEXT DL:POKE SI+4,128
1470 RETURN
1480 IF MU=1 THEN RETURN
1490 POKE SI+1,100:POKE SI+0,0:POKE SI+4,17:FOR DL=1 TO 50:NEXT DL:POKE SI+1,150:FOR DL=1 TO 50:NEXT DL:POKE SI+4,16
1500 RETURN
