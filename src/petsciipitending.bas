10 REM PETSCII PIT - ENDING
20 REM LOADED BY STORY WHEN THE THIEF WALKS INTO THE LIGHT. BASIC ENDS BELOW THE MIRRORED FONT AT $3000
25 POKE 55,0:POKE 56,48:POKE 45,PEEK(174):POKE 46,PEEK(175):CLR
30 POKE 53265,11:POKE 56576,(PEEK(56576)AND 252)OR 3:POKE 648,4:POKE 53272,21
40 POKE 53280,14:POKE 53281,6:POKE 646,14:PRINT CHR$(147);
50 FOR I=828 TO 879:READ X:POKE I,X:NEXT I:SYS 828
60 REM PART-DRAWN CURSOR BLOCKS: 241-247 HAVE THEIR TOP 1-7 LINES SET
70 FOR K=1 TO 7:FOR J=0 TO 7:POKE 12288+(240+K)*8+J,-255*(J<K):NEXT J,K
80 FOR I=55296 TO 56295:POKE I,14:NEXT I:POKE 53272,28
90 R=1:A$="    **** COMMODORE 64 BASIC V2 ****":GOSUB 500
100 R=3:A$=" 64K RAM SYSTEM  38911 BASIC BYTES FREE":GOSUB 500
110 R=5:A$="READY.":GOSUB 500
120 POKE 53265,27:T=TI+120:GOSUB 600
130 REM THE @ AND THE Y, ONE RASTER LINE AT A TIME (MIRRORED: Y LEFT, @ RIGHT)
140 DIM P(7),G(1),C(1):FOR X=0 TO 7:P(X)=2^(7-X):NEXT X:G(0)=25:C(0)=11:G(1)=0:C(1)=21
150 FOR L=0 TO 63:RR=INT(L/8):K=L-8*RR+1:CH=240+K:IF K=8 THEN CH=160
160 FOR N=0 TO 1:B=PEEK(12288+8*G(N)+RR):S=1024+(8+RR)*40+C(N)
170 FOR X=0 TO 7:IF B AND P(X) THEN POKE S+X,CH
180 NEXT X,N:T=TI+2:GOSUB 600:NEXT L
190 T=TI+60:GOSUB 600
200 REM THE CURSOR, DRAWN THE SAME WAY, THEN BLINKING FOREVER
210 S=1024+6*40+39:FOR K=1 TO 8:CH=240+K:IF K=8 THEN CH=160
220 POKE S,CH:T=TI+6:GOSUB 600:NEXT K
230 T=TI+20:GOSUB 600:POKE S,192-PEEK(S):GOTO 230
500 FOR I=1 TO LEN(A$):C=ASC(MID$(A$,I,1)):C=C+64*(C>63):POKE 1024+R*40+40-I,C:NEXT I:RETURN
600 IF TI<T THEN 600
610 RETURN
900 REM MIRROR THE CHARACTER ROM INTO $3000 (SRC/ASM/MIRROR.ASM)
910 DATA 120,169,51,133,1,169,0,133,251,133,253,169,208,133,252,169
920 DATA 48,133,254,162,8,160,0,177,251,133,2,169,1,70,2,42
930 DATA 144,251,145,253,200,208,240,230,252,230,254,202,208,231,169,55
940 DATA 133,1,88,96
